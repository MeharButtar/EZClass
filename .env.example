# Copy to .env and pass it with `docker run --env-file .env`, or set these in the host's
# dashboard (Render: Environment). The app does not read .env by itself. Never commit a real .env.

# 1 turns on Flask's debugger and auto-reload for `python3 backend/app.py`. Never 1 in production.
FLASK_DEBUG=0

# Long random string that unlocks GET /api/admin/stats. Leave empty to switch the stats page off.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# 0 makes /api/event accept and drop every event (no visit counting at all).
ANALYTICS_ENABLED=1

# Where visit counts are stored (a separate SQLite file from the class data).
# Put this on a persistent disk (live: /data/analytics.db) or counts reset on every deploy.
ANALYTICS_DB_PATH=backend/sql/analytics.db

# Where reviews and support messages are stored (another separate SQLite file).
# Defaults to feedback.db next to ANALYTICS_DB_PATH. Put it on the persistent disk too
# (e.g. /data/feedback.db) or every review and message is lost on the next deploy.
FEEDBACK_DB_PATH=backend/sql/feedback.db

# Where the class database lives. Built from data/cleaned on first start if missing or empty.
# On Render leave this UNSET: on the persistent disk it would keep the first import forever.
EZCLASS_DB_PATH=backend/sql/scheduler.db

# The site's public address, for sitemap.xml and robots.txt. Live: https://www.ezclass.win
# (ezclass.win redirects there).
# Optional: without it they use the address the request came in on.
# SITE_URL=https://www.ezclass.win

# Port to listen on. Render (and Fly, AWS App Runner) set this for you.
# PORT=5000
